---
import Cta from './Cta.astro';
import { links } from '../lib/site';
const { show = ['newsletter'], newsletterText = 'Keep up with new science writing, magazine news and opportunities to get involved with PARALLAX.' } = Astro.props;
// Boxes appear in the order they are listed in `show`.
const boxes = {
  submit: { eyebrow: 'Share your work', title: 'Submit an article', text: 'Share your science writing with PARALLAX. Use the button below to begin the submission process.', href: links.upload, label: 'Upload article' },
  newsletter: { eyebrow: 'Stay curious', title: 'Sign up to our newsletter', text: newsletterText, href: links.newsletter, label: 'Subscribe' },
  join: { eyebrow: 'Get involved', title: 'Join the committee', text: 'Help shape the direction of PARALLAX through editorial decisions, event planning and community outreach.', href: links.join, label: 'Join the committee' },
};
---
{show.filter((key) => key in boxes).map((key) => <Cta {...boxes[key]} />)}
