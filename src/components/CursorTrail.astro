---
// Cursor trail: small icons that follow the pointer and fade out.
// Day mode uses microbes in magenta, blue and green; night mode uses shining star images.
// Off for touch screens and for visitors who ask for reduced motion.
---
<div class="cursor-trail" aria-hidden="true"></div>

<style is:global>
  .cursor-trail { position: fixed; inset: 0; pointer-events: none; z-index: 9999; overflow: hidden; }
  .cursor-trail span { position: absolute; top: 0; left: 0; width: 14px; height: 14px; margin: -7px 0 0 -7px; color: var(--accent); }
  .cursor-trail svg, .cursor-trail img { display: block; width: 100%; height: 100%; }
  .cursor-trail span.microbe { width: 24px; height: 24px; margin: -12px 0 0 -12px; }
  .cursor-trail span.star { width: 28px; height: 28px; margin: -14px 0 0 -14px; }
  /* faint dark halo so white stars stay visible over bright photos */
  .cursor-trail span.star img { filter: drop-shadow(0 0 1.5px rgba(11, 31, 38, 0.7)); }
</style>

<script>
  const layer = document.querySelector<HTMLElement>('.cursor-trail');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(pointer: fine)');

  // Day mode: microbes. Each is the inside of a 24x24 SVG drawn in currentColor.
  const microbes = [
    // rod bacterium (bacillus) with flagella
    '<rect x="5" y="9" width="14" height="6" rx="3" fill="currentColor" fill-opacity=".3" stroke="currentColor" stroke-width="1.5"/><path d="M19 12c1.5-1.2 2.5 1.2 4 0M5 12c-1.5 1.2-2.5-1.2-4 0" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><circle cx="10" cy="12" r="1" fill="currentColor"/><circle cx="14" cy="12" r="1" fill="currentColor"/>',
    // round bacteria cluster (cocci)
    '<g fill="currentColor" fill-opacity=".3" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="9" r="4"/><circle cx="16" cy="9" r="4"/><circle cx="12" cy="16" r="4"/></g>',
    // amoeba with nucleus
    '<path d="M12 3c3 0 4 3 6.5 3.5S22 10 20 13s1 6-3 7-5-1-7 0-5-1-5-4-3-4-1-7 5-6 8-6z" fill="currentColor" fill-opacity=".3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="12" cy="11" r="2.5" fill="currentColor"/>',
    // spiral bacterium (spirillum)
    '<path d="M2 14c2.5-6 5-6 7 0s4.5 6 7 0 4.5-6 6 0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>',
    // virus with spikes
    '<circle cx="12" cy="12" r="6" fill="currentColor" fill-opacity=".3" stroke="currentColor" stroke-width="1.5"/><path d="M12 6V3M12 21v-3M6 12H3M21 12h-3M7.8 7.8 5.6 5.6M18.4 18.4l-2.2-2.2M7.8 16.2l-2.2 2.2M18.4 5.6l-2.2 2.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
  ];
  const microbeColours = ['#c2187a', '#1f7ad1', '#2a9d55']; // magenta, blue, green

  // Night mode: shining star images (embedded so no separate image files are needed)
  const stars = [
    'data:image/png;base64,',
    'data:image/png;base64,',
    'data:image/png;base64,',
    'data:image/png;base64,',
    'data:image/png;base64,',
  ];

  const SPACING = 18;   // px the pointer must travel before a new icon appears
  const LIFETIME = 900; // ms each icon stays visible
  const MAX = 40;       // cap on icons on screen at once
  let lastX = -999, lastY = -999;

  function spawn(x: number, y: number) {
    if (!layer || layer.childElementCount >= MAX) return;
    const dark = document.documentElement.dataset.theme === 'dark';
    const pick = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)];
    const el = document.createElement('span');
    if (dark) {
      el.className = 'star';
      el.innerHTML = `<img src="${pick(stars)}" alt="" />`;
    } else {
      el.className = 'microbe';
      el.style.color = pick(microbeColours);
      el.innerHTML = `<svg viewBox="0 0 24 24">${pick(microbes)}</svg>`;
    }
    layer.appendChild(el);

    const size = dark ? 0.7 + Math.random() * 0.8 : 0.6 + Math.random() * 0.6;
    const driftX = (Math.random() - 0.5) * 30;
    const driftY = 20 + Math.random() * 20;
    const spin = (Math.random() - 0.5) * 180;
    el.animate(
      [
        { transform: `translate(${x}px, ${y}px) scale(${size}) rotate(0deg)`, opacity: 0.9 },
        { transform: `translate(${x + driftX}px, ${y + driftY}px) scale(0) rotate(${spin}deg)`, opacity: 0 },
      ],
      { duration: LIFETIME, easing: 'ease-out', fill: 'forwards' },
    ).onfinish = () => el.remove();
  }

  window.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse' || reduced.matches || !finePointer.matches) return;
    if (Math.hypot(e.clientX - lastX, e.clientY - lastY) < SPACING) return;
    lastX = e.clientX; lastY = e.clientY;
    spawn(e.clientX, e.clientY);
  }, { passive: true });
</script>
