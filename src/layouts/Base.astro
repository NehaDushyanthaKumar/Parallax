---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { links, url } from '../lib/site';
import CursorTrail from '../components/CursorTrail.astro';
const { title, description = 'PARALLAX is the University of St Andrews science magazine.', current = '' } = Astro.props;
const nav = [
  ['Home', '/'], ['Articles', '/articles/'], ['Get involved', '/get-involved/'],
  ['Events', '/events/'], ['About us', '/about/'],
];
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} | PARALLAX` : 'PARALLAX | University of St Andrews Science Magazine'}</title>
  <meta name="description" content={description} />
  <style is:inline set:html={`
    html, body, * { cursor: url("${url('/images/cursor.png')}") 16 16, auto !important; }
    a, button, select, summary, label, [role="button"], .btn, .menu-toggle, a *, button * { cursor: url("${url('/images/cursor.png')}") 16 16, pointer !important; }
  `} />
  <script is:inline>
    (() => {
      let theme;
      try { theme = localStorage.getItem('theme'); } catch (e) {}
      if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={url('/')} aria-label="PARALLAX home">
        <span class="brand-name">PARALLAX</span>
        <img src={url('/images/logo-filled-on-magenta.png')} alt="" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu ≡</button>
      <nav class="nav" id="site-nav" aria-label="Main">
        {nav.map(([label, href]) => (
          <a href={url(href)} aria-current={current === label ? 'page' : undefined}>{label}</a>
        ))}
        <a class="subscribe" href={links.newsletter}>Subscribe</a>
      </nav>
      <a class="search-link" href={url('/search/')} aria-label="Search the website">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      </a>
      <button class="theme-toggle" type="button" aria-label="Switch to night mode">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-cols">
        <div>
          <p class="footer-brand">PARALLAX</p>
          <p>Science Magazine<br />University of St Andrews</p>
        </div>
        <div>
          <p class="footer-head">Explore</p>
          <p><a href={url('/articles/')}>Articles</a> · <a href={url('/get-involved/')}>Get involved</a> · <a href={url('/events/')}>Events</a> · <a href={url('/about/')}>About us</a></p>
          <p><a href={url('/about/team/')}>Meet the team</a> · <a href={url('/about/writers/')}>Meet the writers</a></p>
        </div>
        <div>
          <p class="footer-head">Stay in touch</p>
          <p><a href={links.instagram} aria-label="Instagram @parallax.sta" style="display:inline-flex;align-items:center;gap:0.35em;vertical-align:bottom"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/></svg>@parallax.sta</a></p>
          <p><a href={links.newsletter}>Newsletter</a></p>
        </div>
      </div>
      <div class="legal">
        <p>© {new Date().getFullYear()} PARALLAX. Independent and reader supported.</p>
        <p><a href={url('/coming-soon/')}>Privacy policy</a> · <a href={url('/coming-soon/')}>Terms</a> · <a href={url('/coming-soon/')}>Accessibility</a></p>
      </div>
    </div>
  </footer>
  <CursorTrail />
  <script>
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('#site-nav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('open') ?? false;
      toggle.setAttribute('aria-expanded', String(open));
    });

    // Day / night mode
    const root = document.documentElement;
    const themeBtn = document.querySelector('.theme-toggle');
    const label = () => themeBtn?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to day mode' : 'Switch to night mode');
    label();
    themeBtn?.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      label();
    });
    // Follow the device setting until the visitor picks a mode themselves
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch (err) {}
      if (!saved) { root.dataset.theme = e.matches ? 'dark' : 'light'; label(); }
    });
  </script>
</body>
</html>
