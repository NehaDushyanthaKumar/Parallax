---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import { links, url } from '../../lib/site';
---
<Base title="About us" current="About us">
  <Crumbs items={[['Home', '/'], ['About us']]} />
  <h1>About us</h1>
  <p class="lede" style="line-height:1.6">PARALLAX is the new student-led science magazine at the University of St Andrews! We explore scientific concepts, emerging research, and the intersection of science and society across a broad range of disciplines. We aim to communicate science in an accessible, engaging and thought-provoking way. To keep up to date with our latest articles and upcoming events, follow us on <a href={links.instagram} style="display:inline-flex;align-items:center;gap:0.35em;vertical-align:bottom"><svg width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.5"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/></svg>Instagram</a> or <a href={links.newsletter}>sign up to our mailing list</a>!</p>
  <hr class="rule" />
  <h2 class="section-title" style="margin-bottom:20px">PARALLAX</h2>
  <div class="stack">
    <div class="grid-2">
      <section class="outline"><p class="eyebrow">Behind the magazine</p><h2 style="margin-top:12px">Meet the team</h2><a class="text-link" href={url('/about/team/')}>Meet the team →</a></section>
      <section class="outline"><p class="eyebrow">The voices in our articles</p><h2 style="margin-top:12px">Meet the writers</h2><a class="text-link" href={url('/about/writers/')}>Meet the writers →</a></section>
    </div>
    <p class="involve"><a class="btn" href={url('/get-involved/')}>Want to get involved? Click here!</a></p>
  </div>
</Base>

<style>
  .involve { text-align: center; }
  .involve .btn { font-size: 18px; padding: 16px 32px; }
</style>
