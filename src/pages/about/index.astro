---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Ctas from '../../components/Ctas.astro';
import { url } from '../../lib/site';
---
<Base title="About us" current="About us">
  <Crumbs items={[['Home', '/'], ['About us']]} />
  <h1>About us</h1>
  <p class="lede">PARALLAX is St Andrews science magazine: a place for scientific ideas, thoughtful questions and fresh perspectives.</p>
  <hr class="rule" />
  <h2 class="section-title" style="margin-bottom:20px">PARALLAX</h2>
  <div class="stack">
    <div class="grid-2">
      <section class="outline"><p class="eyebrow">Behind the magazine</p><h2 style="margin-top:12px">Meet the team</h2><a class="text-link" href={url('/about/team/')}>Meet the team →</a></section>
      <section class="outline"><p class="eyebrow">The voices in our articles</p><h2 style="margin-top:12px">Meet the writers</h2><a class="text-link" href={url('/about/writers/')}>Meet the writers →</a></section>
    </div>
    <Ctas />
  </div>
</Base>
