---
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Ctas from '../../../components/Ctas.astro';
import Portrait from '../../../components/Portrait.astro';
import { url } from '../../../lib/site';
---
<Base title="Committee profile" current="About us">
  <Crumbs items={[['Home', '/'], ['About us', '/about/'], ['Meet the team', '/about/team/'], ['Committee profile']]} />
  <div class="profile">
    <Portrait />
    <div>
      <h1>Committee member name</h1>
      <p class="role">Committee role</p>
      <div class="outline" style="padding:20px"><p class="eyebrow" style="margin-bottom:8px">Short biography — pending</p><p style="margin:0">A short introduction will be added here once the committee member's details are supplied. No biography has been provided.</p></div>
    </div>
  </div>
  <p style="margin-top:32px"><a class="text-link" href={url('/about/team/')}>Back to Meet the team →</a></p>
  <div class="stack" style="margin-top:40px"><Ctas /></div>
</Base>
