---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Cta from '../../../components/Cta.astro';
import Portrait from '../../../components/Portrait.astro';
import { articlePath, getArticles, sameWriter, url } from '../../../lib/site';
const writers = await getCollection('writers');
const articles = await getArticles();
const cards = writers
  .map((writer) => ({ writer, latest: articles.find((a) => sameWriter(a.data.author, writer.data.name)) }))
  .sort((a, b) => (b.latest?.data.date.getTime() ?? 0) - (a.latest?.data.date.getTime() ?? 0));
---
<Base title="Meet the writers" current="About us">
  <Crumbs items={[['Home', '/'], ['About us', '/about/'], ['Meet the writers']]} />
  <h1>Meet the writers</h1>
  <hr class="rule" />
  <h2 class="section-title" style="margin-bottom:20px">Our writers</h2>
  <div class="grid-2">
    {cards.map(({ writer, latest }) => (
      <section class="person">
        <Portrait src={writer.data.portrait} name={writer.data.name} />
        <h3>{writer.data.name}</h3>
        <a class="text-link" href={url(`/about/writers/${writer.id}/`)}>View writer profile →</a>
        {latest && (<>
          <hr class="rule" style="margin:16px 0" />
          <p class="eyebrow" style="margin-bottom:12px">Most recent submission</p>
          <h3 style="font-size:18px;margin:0"><a href={url(articlePath(latest))} style="text-decoration:none">{latest.data.title}</a></h3>
        </>)}
      </section>
    ))}
  </div>
  <div style="margin-top:48px">
    <Cta title="Could your story be next?" text="Have a topic you’d love to explore? Then write for us! Whether you want to write one article or twenty, you can explore any topic in science that interests you!" href={url('/get-involved/write-for-us/')} label="Pitch to us!" centered />
  </div>
  <p style="margin-top:32px"><a class="text-link" href={url('/about/')}>Back to About us →</a></p>
</Base>
