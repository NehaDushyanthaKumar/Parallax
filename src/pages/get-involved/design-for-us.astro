---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Ctas from '../../components/Ctas.astro';
import { links } from '../../lib/site';
---
<Base title="Design for us" current="Get involved">
  <Crumbs items={[['Home', '/'], ['Get involved', '/get-involved/'], ['Design for us']]} />
  <h1 style="margin-bottom:32px">Design for us</h1>
  <a class="btn" href={links.design}>Design for us</a>
  <h2 class="section-title" style="margin:48px 0 12px">Show us how you see science.</h2>
  <p>Have your examples and a short introduction ready to share. This page introduces a new way to contribute.</p>
  <div class="stack" style="margin-top:48px"><Ctas show={['newsletter', 'join']} /></div>
</Base>
