---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Ctas from '../../components/Ctas.astro';
import { links } from '../../lib/site';
---
<Base title="Design for us" current="Get involved">
  <Crumbs items={[['Home', '/'], ['Get involved', '/get-involved/'], ['Design for us']]} />
  <h1>Design for us!</h1>
  <hr class="rule" />
  <div>
    <p style="margin-bottom:20px">If you’re interested in graphic design, illustration, photography or web design, we would love to hear from you. We’re looking for people to produce artwork for our online articles, marketing materials and our upcoming print edition!</p>
    <p style="margin-bottom:28px">If you’re interested fill in the form below!</p>
    <a class="btn" href={links.design}>Design for us!</a>
  </div>
  <div class="stack" style="margin-top:48px"><Ctas show={['newsletter', 'join']} /></div>
</Base>
